# Copy to .env (git-ignored) and fill in. NEVER commit real keys. Rotate any key that was ever pasted into a chat, doc or repo.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Optional model overrides (defaults are unverified; set the model names your accounts support)
GEMINI_MODEL=
GROQ_MODEL=
OPENROUTER_MODEL=
# LOCAL (no cloud), CLOUD (providers only, no silent fallback) or HYBRID (cloud then explicit local fallback)
EMBCOPILOT_AI_MODE=LOCAL
