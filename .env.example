# Copy to .env (git-ignored) and fill in. NEVER commit real keys. Rotate any key that was ever pasted into a chat, doc or repo.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Optional model overrides (defaults are unverified; set the model names your accounts support)
GEMINI_MODEL=
GROQ_MODEL=
OPENROUTER_MODEL=
# LOCAL (no cloud), CLOUD (providers only, no silent fallback) or HYBRID (cloud then explicit local fallback)
EMBCOPILOT_AI_MODE=LOCAL

# ===========================================================================
# EmbroideryCopilot Outreach CRM
# ===========================================================================
# Copy this file to `.env` and fill in real values.  `.env` is git-ignored;
# NEVER commit real credentials.  If a key was ever pasted into a chat, a
# document or a commit, rotate it.
#
#   Copy-Item .env.example .env
#
# Existing environment variables always take priority over this file.

# --- Zoho Mail SMTP (send) -----------------------------------------------
ZOHO_SMTP_HOST=smtppro.zoho.in
ZOHO_SMTP_PORT=587
ZOHO_SMTP_USER=founder@embroiderycopilot.com
# Your Zoho app password (NOT your account password).
# Zoho: https://accounts.zoho.com/ -> Mail -> Generate password for desktop client
ZOHO_SMTP_PASS=

# --- Sender identity ------------------------------------------------------
OUTREACH_SENDER_NAME=Embroidery Copilot
OUTREACH_REPLY_TO=founder@embroiderycopilot.com
OUTREACH_SERVICE_NAME=custom embroidery digitizing and production

# --- Sending safeguards ---------------------------------------------------
# Maximum messages per calendar day.
OUTREACH_DAILY_LIMIT=50
# Minimum seconds between two messages.
OUTREACH_MIN_INTERVAL=45
# Retry attempts for transient SMTP failures only.
OUTREACH_MAX_RETRIES=3
OUTREACH_RETRY_BASE_DELAY=60

# --- Telegram bot (optional) ----------------------------------------------
# Token from @BotFather
TELEGRAM_TOKEN=
# Comma-separated numeric Telegram user IDs allowed to run commands.
# Leave EMPTY to disable all remote commands. Get your ID from @userinfobot.
TELEGRAM_ALLOWED_IDS=
